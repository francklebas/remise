# Copy to .env.development.local after running `bun run supabase:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Copy the anon key printed by `bun run supabase:status`.
VITE_SUPABASE_ANON_KEY=your-local-anon-key
# Leave empty locally unless Turnstile is also configured in local Supabase.
VITE_TURNSTILE_SITE_KEY=
VITE_APP_URL=http://localhost:5173
